{
  "name": "asset-management",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:capture": "node --import tsx scripts/test-capture-chrome.mjs",
    "mcp": "tsx server/mcp.ts",
    "check": "npm run format:check && npm run build && npm test",
    "format": "prettier --write src server shared desktop scripts tests extension *.ts *.json index.html",
    "format:check": "prettier --check src server shared desktop scripts tests extension *.ts *.json index.html",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && electron .",
    "desktop:smoke": "electron . --smoke-test",
    "package:desktop": "npm run build:desktop && electron-builder --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@tanstack/react-table": "^8.21.3",
    "cytoscape": "^3.33.1",
    "lucide-react": "^0.468.0",
    "mdast-util-from-markdown": "^2.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "main": "desktop-build/main.cjs",
  "description": "A personal asset and knowledge library",
  "author": "Atlas contributors",
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.1"
  }
}
