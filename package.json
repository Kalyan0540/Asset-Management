{
  "name": "asset-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "mcp": "tsx server/mcp.ts",
    "check": "npm run format:check && npm run build && npm test",
    "format": "prettier --write src server shared tests *.ts *.json index.html",
    "format:check": "prettier --check src server shared tests *.ts *.json index.html"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@tanstack/react-table": "^8.21.3",
    "cytoscape": "^3.33.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
